generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PARTNER
  DISTRICT_ADMIN
  SUB_SUPER
  FINANCE
  PACKING
  ADMIN
}

enum CourseMode {
  LIVE_STUDY
  HYBRID
  STUDY_ONLY
  ONLINE_PRERECORDED
  LIVE_ONLY
}
enum BlogStatus {
  DRAFT
  PUBLISHED
}
enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  AWAITING_PACKING
  PACKED
  LABEL_GENERATED
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  MORE_INFO
  APPROVED
  REJECTED
  ACTIVE
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  mobile       String?  @unique
  referralCode String?  @unique
  password     String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentId   Int?
  parent     User?     @relation("Sponsor", fields: [parentId], references: [id])
  children   User[]    @relation("Sponsor")
  districtId Int?
  district   District? @relation("DistrictPartners", fields: [districtId], references: [id])

  districts       District[]    @relation("DistrictAdmin")
  students        Student[]     @relation("PartnerStudents")
  orders          Order[]       @relation("PartnerOrders")
  ledger          LedgerEntry[] @relation("UserLedger")
  packedShipments Shipment[]    @relation("PackedShipments")
  payouts         Payout[]      @relation("PayoutOwner")
  reviewedPayouts Payout[]      @relation("PayoutReviewer")

  applicationsSponsored PartnerApplication[] @relation("ApplicationSponsor")
  application           PartnerApplication?  @relation("ApplicationUser")
}

model District {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?  @unique
  adminId   Int?
  admin     User?    @relation("DistrictAdmin", fields: [adminId], references: [id])
  partners  User[]   @relation("DistrictPartners")
  createdAt DateTime @default(now())

  applications PartnerApplication[]
}

model PartnerApplication {
  id           Int               @id @default(autoincrement())
  name         String
  email        String
  mobile       String
  passwordHash String
  panMasked    String?
  experience   String            @db.Text
  districtId   Int?
  district     District?         @relation(fields: [districtId], references: [id])
  sponsorId    Int?
  sponsor      User?             @relation("ApplicationSponsor", fields: [sponsorId], references: [id])
  status       ApplicationStatus @default(SUBMITTED)
  note         String?           @db.Text
  feePaid      Boolean           @default(false)
  feePaidAt    DateTime?
  userId       Int?              @unique
  user         User?             @relation("ApplicationUser", fields: [userId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([email])
  @@index([status])
}

model Course {
  id        Int        @id @default(autoincrement())
  name      String
  mode      CourseMode
  price     Decimal    @db.Decimal(10, 2)
  isActive  Boolean    @default(true)
  orders    Order[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
    slug        String?  @unique
  summary     String?  @db.VarChar(300)
  description String?  @db.Text
  coverImage  String?  @db.VarChar(500)
  prices      CoursePrice[]
  topics CourseTopic[]
  categoryId  Int?
  category    CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  overview    String?         @db.Text
  eligibility String?         @db.Text
  keyBenefits String?         @db.Text
    offerPrice  Decimal?  @db.Decimal(10, 2)
  offerLabel  String?   @db.VarChar(80)
  offerEndsAt DateTime?

  @@index([categoryId])
  
}

model Student {
  id           Int       @id @default(autoincrement())
  name         String
  mobile       String    @unique
  email        String?
  addressLine  String?
  city         String?
  pincode      String?
  passwordHash String?
  isActive     Boolean   @default(true)
  referredAt   DateTime?
  partnerId    Int?
  partner      User?     @relation("PartnerStudents", fields: [partnerId], references: [id])
  orders       Order[]
  createdAt    DateTime  @default(now())
}

model StudentAdmin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuthAttempt {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

model Order {
  id        Int           @id @default(autoincrement())
  studentId Int
  student   Student       @relation(fields: [studentId], references: [id])
  courseId  Int
  course    Course        @relation(fields: [courseId], references: [id])
  partnerId Int?
  partner   User?         @relation("PartnerOrders", fields: [partnerId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  status    OrderStatus   @default(PENDING)
  ledger    LedgerEntry[]
  shipment  Shipment?
  createdAt DateTime      @default(now())
    mode CourseMode?
}

model LedgerEntry {
  id        Int      @id @default(autoincrement())
  orderId   Int?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payoutId  Int?
  payout    Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  userId    Int?
  user      User?    @relation("UserLedger", fields: [userId], references: [id])
  type      String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}

model Payout {
  id           Int           @id @default(autoincrement())
  userId       Int
  user         User          @relation("PayoutOwner", fields: [userId], references: [id], onDelete: Restrict)
  amount       Decimal       @db.Decimal(10, 2)
  status       PayoutStatus  @default(REQUESTED)
  utr          String?       @unique
  note         String?       @db.Text
  requestedAt  DateTime      @default(now())
  reviewedById Int?
  reviewedBy   User?         @relation("PayoutReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  paidAt       DateTime?
  updatedAt    DateTime      @updatedAt
  ledger       LedgerEntry[]

  @@index([userId])
  @@index([status])
}

model Shipment {
  id          Int             @id @default(autoincrement())
  orderId     Int             @unique
  order       Order           @relation(fields: [orderId], references: [id])
  status      ShipmentStatus  @default(AWAITING_PACKING)
  weightGrams Int?
  courier     String?
  awb         String?         @unique
  packedAt    DateTime?
  packedById  Int?
  packedBy    User?           @relation("PackedShipments", fields: [packedById], references: [id])
  events      ShipmentEvent[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ShipmentEvent {
  id         Int            @id @default(autoincrement())
  shipmentId Int
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  note       String?
  createdAt  DateTime       @default(now())

  @@index([shipmentId])
}

model Notification {
  id            Int                 @id @default(autoincrement())
  channel       NotificationChannel
  recipientName String
  recipient     String
  message       String              @db.Text
  event         String
  refType       String?
  refId         Int?
  status        NotificationStatus  @default(QUEUED)
  provider      String?
  error         String?             @db.Text
  attempts      Int                 @default(0)
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  @@index([status])
  @@index([createdAt])
}

model CommissionRule {
  id                Int      @id @default(autoincrement())
  gstPercent        Decimal  @default(18) @db.Decimal(5, 2)
  gatewayFeePercent Decimal  @default(2) @db.Decimal(5, 2)
  partnerPercent    Decimal  @default(40) @db.Decimal(5, 2)
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())
}
model CoursePrice {
  id       Int        @id @default(autoincrement())
  courseId Int
  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mode     CourseMode
  price    Decimal    @db.Decimal(10, 2)

  @@unique([courseId, mode])
}

model BlogPost {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  excerpt     String?    @db.VarChar(300)
  content     String     @db.LongText
  coverImage  String?    @db.VarChar(500)
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?
  authorName  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}

enum LessonType {
  VIDEO
  TEXT
  LIVE
}

model CourseTopic {
  id        Int      @id @default(autoincrement())
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(160)
  summary   String?  @db.Text
  position  Int      @default(0)
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, position])
}

model Lesson {
  id           Int         @id @default(autoincrement())
  topicId      Int
  topic        CourseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title        String      @db.VarChar(160)
  type         LessonType  @default(VIDEO)
  content      String?     @db.Text
  videoUrl     String?     @db.VarChar(500)
  liveUrl      String?     @db.VarChar(500)
  liveStartsAt DateTime?
  durationMin  Int?
  isPreview    Boolean     @default(false)
  isPublished  Boolean     @default(true)
  position     Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  files        LessonFile[]
  @@index([topicId, position])
}
model CourseCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  position  Int      @default(0)
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  mobile    String?
  topic     String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}
model LessonFile {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(200)
  storedAs  String   @db.VarChar(80)
  mimeType  String   @db.VarChar(120)
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([lessonId])
}

enum SubSuperBase {
  REMAINDER
  DISTRIBUTABLE
}

enum InactiveRule {
  SKIP_TO_SUPER_ADMIN
  COMPRESS
}

enum GatewayMode {
  DEDUCT_FIRST
  SUPER_ADMIN_BEARS
}

model CommissionRuleVersion {
  id                Int          @id @default(autoincrement())
  version           Int          @unique
  level1Percent     Decimal      @db.Decimal(5, 2)
  level2Percent     Decimal      @db.Decimal(5, 2)
  level3Percent     Decimal      @db.Decimal(5, 2)
  level4Percent     Decimal      @db.Decimal(5, 2)
  level5Percent     Decimal      @db.Decimal(5, 2)
  districtPercent   Decimal      @db.Decimal(5, 2)
  subSuperPercent   Decimal      @db.Decimal(5, 2)
  subSuperBase      SubSuperBase @default(REMAINDER)
  inactiveRule      InactiveRule @default(SKIP_TO_SUPER_ADMIN)
  gatewayMode       GatewayMode  @default(DEDUCT_FIRST)
  gstPercent        Decimal      @default(18) @db.Decimal(5, 2)
  gatewayFeePercent Decimal      @default(2) @db.Decimal(5, 2)
  note              String?      @db.VarChar(200)
  createdById       Int?
  createdAt         DateTime     @default(now())
  approvedById      Int?
  approvedAt        DateTime?
}